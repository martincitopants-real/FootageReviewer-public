<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FootageReviewer.App.Views.RenameProjectWindow"
        Width="460" SizeToContent="Height"
        Background="#0F0F14"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Rename project">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Rename project" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Foreground="#9A9AA8" FontSize="12" TextWrapping="Wrap"
                   Text="Renames the .frproj file on disk (and its backups folder). New name (without extension):"/>
        <TextBox x:Name="NameBox" Watermark="project name" FontSize="13"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF7676" FontSize="11" IsVisible="False" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Focusable="False"/>
            <Button x:Name="RenameBtn" Content="Rename" Background="#274050" Foreground="#FFFFFF" Focusable="False"/>
        </StackPanel>
    </StackPanel>
</Window>
